<?xml version="1.0" encoding="UTF-8" ?>
<!-- /local/referral/db/install.xml -->
<XMLDB PATH="local/referral/db" VERSION="2026050800" COMMENT="Referral plugin tables">
    <TABLES>
        <TABLE NAME="local_ref_marketers" COMMENT="Referral marketers">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="code" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Referral code"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Display name"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Linked marketer user ID"/>
                <FIELD NAME="parent_id" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Parent marketer ID (for sub-marketers)"/>
                <FIELD NAME="commission_percentage" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="10" COMMENT="Commission percentage"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Created at"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Modified at"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="code_uix" UNIQUE="true" FIELDS="code"/>
                <INDEX NAME="userid_uix" UNIQUE="true" FIELDS="userid"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_ref_users" COMMENT="User to marketer referrals">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="User ID"/>
                <FIELD NAME="marketerid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Marketer ID"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Created at"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="userid_uix" UNIQUE="true" FIELDS="userid"/>
                <INDEX NAME="marketer_idx" UNIQUE="false" FIELDS="marketerid"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="local_ref_commissions" COMMENT="Referral commissions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="marketerid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Marketer ID"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Referred user ID"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
                <FIELD NAME="amount" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" COMMENT="Paid amount"/>
                <FIELD NAME="commission" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" COMMENT="Commission value"/>
                <FIELD NAME="status" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="0=pending,1=approved,2=paid"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Created at"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="marketer_idx" UNIQUE="false" FIELDS="marketerid"/>
                <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>
                <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
                <INDEX NAME="usercourse_uix" UNIQUE="true" FIELDS="userid, courseid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_ref_withdrawals" COMMENT="Marketer withdrawal requests">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="marketerid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Marketer ID"/>
                <FIELD NAME="amount" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" COMMENT="Requested amount"/>
                <FIELD NAME="status" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="0=pending,1=done,2=rejected"/>
                <FIELD NAME="notes" TYPE="text" NOTNULL="false" COMMENT="Admin notes"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Created at"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Modified at"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="marketer_idx" UNIQUE="false" FIELDS="marketerid"/>
                <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="local_ref_disbursements" COMMENT="Manual payment disbursement records">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="category" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Disbursement category (Servers, Center, Coordinators, IT)"/>
                <FIELD NAME="recipient_name" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Recipient name"/>
                <FIELD NAME="amount" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" COMMENT="Disbursed amount"/>
                <FIELD NAME="period_start" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Period start timestamp"/>
                <FIELD NAME="period_end" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Period end timestamp"/>
                <FIELD NAME="receipt_file" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Stored receipt filename"/>
                <FIELD NAME="notes" TYPE="text" NOTNULL="false" COMMENT="Optional notes"/>
                <FIELD NAME="created_by" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Admin user who recorded this"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Created at"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="category_idx" UNIQUE="false" FIELDS="category"/>
                <INDEX NAME="period_idx" UNIQUE="false" FIELDS="period_start, period_end"/>
                <INDEX NAME="created_by_idx" UNIQUE="false" FIELDS="created_by"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
